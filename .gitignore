# Build output — the assemblies are built into the fork's Distribution\Assemblies, never here
obj/
bin/
*.user

# Runtime
logs/

# Runtime state, not configuration — the observer's accumulated beliefs from one machine
Distribution/Configuration/bot-debugger-memory.json

# Engine configuration that is ModernUO's, not this project's. Only bot-*.json belongs here.
Distribution/Configuration/*.json
!Distribution/Configuration/bot-*.json
Distribution/Configuration/bot-*-before-*.json
